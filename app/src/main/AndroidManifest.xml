<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== 短信 ===== -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- ===== 网络 ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ===== 通知（Android 13+ 运行时权限） ===== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== 开机自启 / 前台服务 ===== -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 起前台服务必须声明明确类型，remoteMessaging = 设备间消息转发 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 硬件可选项，避免应用商店误判 -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsRelay"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="35">

        <!--
          短信广播接收器。
          1) SMS_RECEIVED_ACTION 属于 Android 8.0 隐式广播豁免名单，静态注册长期有效；
          2) android:permission=BROADCAST_SMS 限定只有系统能发给我们，防伪造；
          3) directBootAware=true：重启后尚未解锁时也能收到，未解锁事件会暂存到
             device-protected storage，解锁后补发（见 PendingStore）。
          4) 不声明 android:priority：Android 16 起跨进程广播优先级不再保证，
             既然拿不到优先也就不要写，避免被判定为「拦截短信」行为。
        -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
          生命周期接收器：开机 / 应用自更新 / 用户解锁后拉起前台服务。
          这三个 Action 属于「后台启动前台服务」的官方豁免场景，可以合法拉起。
        -->
        <receiver
            android:name=".receiver.LifecycleReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <!--
          常驻前台服务：进程保活 + 动态注册短信广播 + 待发队列消费。
          stopWithTask=false：用户一键清理时不要把服务带走（澎湃OS 上很关键）。
        -->
        <service
            android:name=".service.RelayService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging"
            android:stopWithTask="false" />

        <!--
          通知监听：仅作补偿通道。
          Android 15+ 未授信的 listener 读到的 OTP 通知内容会被系统替换为
          「sensitive notification content hidden」，所以不能作为主通道依赖。
        -->
        <service
            android:name=".service.RelayNotificationListener"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations,alerting" />
        </service>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
